# Copy to _environment.local (git-ignored) and adjust; build_reference.sh sources it and quarto
# reads it alongside _environment.
# Python with spidepy, quartodoc, jupyter installed (executes the Python examples):
QUARTO_PYTHON=/path/to/envs/spidepy/bin/python
# A spidepy checkout (docs/r-to-python.md, docs/r-discrepancies.md, docs/tutorial.ipynb):
SPIDEPY_DIR=/path/to/spidepy
# Library holding SpaNorm >= 1.7.15 and the other dependencies, if not in your default R library:
# R_LIBS=/path/to/site/_rlib:/path/to/lib   (R CMD INSTALL -l _rlib .. puts the checkout's spiDE first)
# Only needed when R and Python come from different conda envs and pyexpat fails with
# "undefined symbol: XML_SetAllocTrackerActivationThreshold": preload the Python env's libexpat.
# LD_PRELOAD=/path/to/envs/spidepy/lib/libexpat.so.1
