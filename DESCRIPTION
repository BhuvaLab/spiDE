Package: spiDE
Title: Context-specific, neighbourhood-dependent differential expression
Version: 0.99.8
Authors@R: c(
            person(given = "Dharmesh D.",
                   family = "Bhuva",
                   role = c("aut", "cre"),
                   email = "d.bhuva@uq.edu.au",
                   comment = c(ORCID = "0000-0002-6398-9157")),
