Package: spiDE
Title: Context-specific, neighbourhood-dependent differential expression
Version: 0.99.30
Authors@R: c(
            person(given = "Dharmesh D.",
                   family = "Bhuva",
                   role = c("aut", "cre"),
                   email = "d.bhuva@uq.edu.au",
                   comment = c(ORCID = "0000-0002-6398-9157")),
            person(given = "Chin Wee",
                   family = "Tan",
                   role = c("aut"),
                   email = "cwtan@wehi.edu.au",
                   comment = c(ORCID = "0000-0001-9695-7218"))
